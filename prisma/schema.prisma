generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum UserGender {
  MALE
  FEMALE
}

enum Religion {
  ISLAM
  CHRISTIANITY
  JUDAISM
  ZOROASTRIANISM
  OTHER
}

enum SupplierType {
  GOVERNMENT_ORGANIZATION
  CHARITY
  COMPANY
  STORE
  MANUFACTURER
  WAREHOUSE
  SUPPLIER
  OTHER
}

model Role {
  id        String     @id @default(uuid())
  code      String     @unique
  nameKey   String
  userRoles UserRole[]
  menus     RoleMenu[]
  createdAt DateTime   @default(now())

  @@map("roles")
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model User {
  id                  String        @id @default(uuid())
  username            String        @unique
  passwordHash        String
  firstName           String
  lastName            String
  fullName            String
  locale              String        @default("fa")
  status              UserStatus    @default(ACTIVE)
  gender              UserGender?
  nationalId          String?       @unique
  phone               String?       @unique
  email               String?       @unique
  birthDate           DateTime?     @db.Date
  address             String?
  notes               String?
  religion            Religion?
  religionOther       String?
  telegram            String?
  bale                String?
  eitaa               String?
  whatsapp            String?
  otherSocial         String?
  vehiclePlates       String[]      @default([])
  countryId           String?
  country             Country?      @relation(fields: [countryId], references: [id], onDelete: SetNull)
  provinceId          String?
  province            Province?     @relation("UserHomeProvince", fields: [provinceId], references: [id], onDelete: SetNull)
  cityId              String?
  city                City?         @relation("UserHomeCity", fields: [cityId], references: [id], onDelete: SetNull)
  issuingOrganizationId String?
  issuingOrganization   GovernmentOrganization? @relation(fields: [issuingOrganizationId], references: [id], onDelete: Restrict)
  photoId             String?
  photo               StoredImage?  @relation("UserPhoto", fields: [photoId], references: [id], onDelete: SetNull)
  nationalCardPhotoId String?
  nationalCardPhoto   StoredImage?  @relation("UserNationalCard", fields: [nationalCardPhotoId], references: [id], onDelete: SetNull)
  passportPhotoId     String?
  passportPhoto       StoredImage?  @relation("UserPassport", fields: [passportPhotoId], references: [id], onDelete: SetNull)
  userRoles           UserRole[]
  smsMessages         SmsMessage[]
  managedAccommodations AccommodationManager[]
  accommodationContacts AccommodationContact[]
  accommodationYearContacts AccommodationYearContact[]
  managedCaravans       Caravan[] @relation("CaravanManager")
  managedCaravanYears   CaravanYear[] @relation("CaravanYearManager")
  managedGroups         Group[]   @relation("GroupManager")
  caravanContacts       CaravanContact[]
  createdReservations   Reservation[] @relation("ReservationCreator")
  managedReservations   Reservation[] @relation("ReservationCaravanManager")
  reservationMembers    ReservationMember[]
  reservationCaravanContacts ReservationCaravanContact[] @relation("ReservationCaravanContactPerson")
  reservationMemberInsuranceVerifications ReservationMember[] @relation("ReservationMemberInsuranceVerifier")
  reservationMemberInsurancePayments ReservationMember[] @relation("ReservationMemberInsurancePayer")
  rejectedReservations  Reservation[] @relation("ReservationRejecter")
  cancelledReservations Reservation[] @relation("ReservationCanceller")
  reservationBasicInfoCompletions Reservation[] @relation("ReservationBasicInfoCompleter")
  reservationManagementReviews Reservation[] @relation("ReservationManagementReviewer")
  reservationCompanionsCompletions Reservation[] @relation("ReservationCompanionsCompleter")
  reservationCaravanContactsCompletions Reservation[] @relation("ReservationCaravanContactsCompleter")
  reservationInsuranceCompletions Reservation[] @relation("ReservationInsuranceCompleter")
  reservationFinalCompletions Reservation[] @relation("ReservationFinalCompleter")
  representedProvinces  Province[] @relation("ProvinceHeadquartersRep")
  representedCities     City[]     @relation("CityHeadquartersRep")
  accommodationLoans    AccommodationLoan[]
  itemQuotaVouchers     ItemQuotaVoucher[]
  iceVouchers           IceVoucher[]
  approvedIceVouchers   IceVoucher[] @relation("IceVoucherApprover")
  issuedLicenses        IssuedLicense[] @relation("LicenseIssuer")
  managedLicenses       IssuedLicense[] @relation("LicenseManager")
  approvedLicenses      IssuedLicense[] @relation("LicenseApprover")
  revokedLicenses       IssuedLicense[] @relation("LicenseRevoker")
  reservationPermitReviews Reservation[] @relation("ReservationPermitReviewer")
  managedOrgUnits       OrgUnit[] @relation("OrgUnitManager")
  evaluationsAsEvaluator Evaluation[] @relation("EvaluationEvaluator")
  evaluationsAsTarget    Evaluation[] @relation("EvaluationTarget")
  evaluationsSubmitted   Evaluation[] @relation("EvaluationSubmitter")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([status])
  @@index([fullName])
  @@index([lastName])
  @@index([createdAt])
  @@index([countryId])
  @@index([provinceId])
  @@index([cityId])
  @@index([issuingOrganizationId])
  @@map("users")
}

model GovernmentOrganization {
  id            String   @id @default(uuid())
  name          String
  phone         String?
  address       String?
  contactPerson String?
  mobile        String?
  description   String?
  users         User[]
  issuedLicenses IssuedLicense[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([name])
  @@index([createdAt])
  @@map("government_organizations")
}

model NavModule {
  id        String @id @default(uuid())
  code      String @unique
  nameKey   String
  icon      String
  sortOrder Int    @default(0)
  menus     Menu[]

  @@map("nav_modules")
}

model Menu {
  id        String     @id @default(uuid())
  moduleId  String
  module    NavModule  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  code      String     @unique
  nameKey   String
  path      String
  icon      String
  sortOrder Int        @default(0)
  roles     RoleMenu[]

  @@map("menus")
}

model RoleMenu {
  roleId String
  menuId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menu   Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@id([roleId, menuId])
  @@map("role_menus")
}

model StoredImage {
  id                String   @id @default(uuid())
  mimeType          String
  data              Bytes
  byteSize          Int
  width             Int?
  height            Int?
  originalName      String?
  photoUsers        User[]   @relation("UserPhoto")
  nationalCardUsers User[]   @relation("UserNationalCard")
  passportUsers     User[]   @relation("UserPassport")
  caravanLicenses   Caravan[] @relation("CaravanLicenseImage")
  issuedLicenseFiles IssuedLicense[] @relation("IssuedLicenseFile")
  reservationPermitImages Reservation[] @relation("ReservationPermitImage")
  headquartersLogos HeadquartersInfo[] @relation("HeadquartersLogo")
  createdAt         DateTime @default(now())

  @@map("stored_images")
}

enum CaravanContactRole {
  DEPUTY
  CLERIC
  CULTURAL
  SECURITY
  RECEPTION
}

model Caravan {
  id             String       @id @default(uuid())
  name           String
  description    String?
  officeAddress  String?
  officePhone    String?
  foundedYear    Int?
  licenseNumber  String?
  cityId         String
  city           City         @relation(fields: [cityId], references: [id], onDelete: Restrict)
  walkingRouteId String?
  walkingRoute   WalkingRoute? @relation(fields: [walkingRouteId], references: [id], onDelete: Restrict)
  licenseImageId String?
  licenseImage   StoredImage? @relation("CaravanLicenseImage", fields: [licenseImageId], references: [id], onDelete: SetNull)
  managerUserId  String?
  manager        User?        @relation("CaravanManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  contacts       CaravanContact[]
  years          CaravanYear[]
  reservations   Reservation[]
  issuedLicenses IssuedLicense[]
  totalCount     Int          @default(0)
  maleCount      Int          @default(0)
  femaleCount    Int          @default(0)
  eitaa          String?
  bale           String?
  telegram       String?
  instagram      String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([cityId])
  @@index([walkingRouteId])
  @@index([managerUserId])
  @@index([isActive])
  @@map("caravans")
}

model CaravanContact {
  id        String             @id @default(uuid())
  caravanId String
  caravan   Caravan            @relation(fields: [caravanId], references: [id], onDelete: Cascade)
  role      CaravanContactRole
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([caravanId, role])
  @@index([userId])
  @@map("caravan_contacts")
}

model CaravanYear {
  id            String   @id @default(uuid())
  caravanId     String
  caravan       Caravan  @relation(fields: [caravanId], references: [id], onDelete: Cascade)
  year          Int
  managerUserId String?
  manager       User?    @relation("CaravanYearManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@unique([caravanId, year])
  @@index([year])
  @@index([caravanId, year])
  @@index([managerUserId])
  @@map("caravan_years")
}

enum IssuedLicenseStatus {
  ISSUED
  APPROVED
  REVOKED
}

model IssuedLicense {
  id             String              @id @default(uuid())
  managerUserId  String
  manager        User                @relation("LicenseManager", fields: [managerUserId], references: [id], onDelete: Restrict)
  caravanId      String
  caravan        Caravan             @relation(fields: [caravanId], references: [id], onDelete: Restrict)
  issuerUserId   String
  issuer         User                @relation("LicenseIssuer", fields: [issuerUserId], references: [id], onDelete: Restrict)
  organizationId String?
  organization   GovernmentOrganization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  description    String?
  issuedAt       DateTime            @db.Date
  status         IssuedLicenseStatus @default(ISSUED)
  revokedAt      DateTime?
  revokedById    String?
  revokedBy      User?               @relation("LicenseRevoker", fields: [revokedById], references: [id], onDelete: Restrict)
  approvedAt     DateTime?
  approvedById   String?
  approvedBy     User?               @relation("LicenseApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  fileId         String?
  file           StoredImage?        @relation("IssuedLicenseFile", fields: [fileId], references: [id], onDelete: SetNull)
  reservations   Reservation[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([issuerUserId])
  @@index([managerUserId])
  @@index([caravanId])
  @@index([organizationId])
  @@index([approvedById])
  @@index([revokedById])
  @@index([status])
  @@index([issuedAt])
  @@index([createdAt])
  @@map("issued_licenses")
}

model Group {
  id             String        @id @default(uuid())
  name           String
  cityId         String
  city           City          @relation(fields: [cityId], references: [id], onDelete: Restrict)
  walkingRouteId String?
  walkingRoute   WalkingRoute? @relation(fields: [walkingRouteId], references: [id], onDelete: Restrict)
  managerUserId  String?
  manager        User?         @relation("GroupManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  totalCount     Int           @default(0)
  maleCount      Int           @default(0)
  femaleCount    Int           @default(0)
  eitaa          String?
  bale           String?
  telegram       String?
  instagram      String?
  reservations   Reservation[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([cityId])
  @@index([walkingRouteId])
  @@index([managerUserId])
  @@map("groups")
}

enum ReservationType {
  INDIVIDUAL
  GROUP
  CARAVAN
}

enum ReservationStatus {
  DRAFT
  PENDING_MANAGEMENT_REVIEW
  COMPANIONS
  CARAVAN_CONTACTS
  INSURANCE
  COMPLETED
  REJECTED
  CANCELLED
}

enum ReservationMemberInsuranceStatus {
  PENDING
  PAID
  APPROVED
  REJECTED
}

enum ReservationMemberInsurancePaidMethod {
  MANAGEMENT
  ONLINE_GATEWAY
}

enum ReservationPermitStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum ReservationPermitSource {
  UPLOAD
  ISSUED_LICENSE
}

model Reservation {
  id          String            @id @default(uuid())
  createdById String
  createdBy   User              @relation("ReservationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  year        Int
  type        ReservationType
  status      ReservationStatus @default(DRAFT)

  /// Last step of the owner create wizard while status is DRAFT (type|party|count|dates|services|license).
  createWizardStep String?

  originCityId     String?
  originCity       City?     @relation("ReservationOriginCity", fields: [originCityId], references: [id], onDelete: SetNull)
  walkingRouteId   String?
  walkingRoute     WalkingRoute? @relation(fields: [walkingRouteId], references: [id], onDelete: Restrict)

  stayStartDate    DateTime? @db.Date
  stayEndDate      DateTime? @db.Date
  walkingStartDate DateTime? @db.Date

  requestsAccommodation Boolean @default(true)
  requestsBus           Boolean @default(true)

  requestedMaleCount   Int @default(0)
  requestedFemaleCount Int @default(0)
  maleCount            Int @default(0)
  femaleCount          Int @default(0)
  totalCount           Int @default(0)

  caravanId        String?
  caravan          Caravan? @relation(fields: [caravanId], references: [id], onDelete: SetNull)
  groupId          String?
  group            Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  caravanManagerId String?
  caravanManager   User?    @relation("ReservationCaravanManager", fields: [caravanManagerId], references: [id], onDelete: Restrict)

  hasPermit              Boolean                   @default(false)
  permitStatus           ReservationPermitStatus   @default(NONE)
  permitSource           ReservationPermitSource?
  permitImageId          String?
  permitImage            StoredImage?              @relation("ReservationPermitImage", fields: [permitImageId], references: [id], onDelete: SetNull)
  issuedLicenseId        String?
  issuedLicense          IssuedLicense?            @relation(fields: [issuedLicenseId], references: [id], onDelete: SetNull)
  permitReviewedAt       DateTime?
  permitReviewedById     String?
  permitReviewedBy       User?                     @relation("ReservationPermitReviewer", fields: [permitReviewedById], references: [id], onDelete: Restrict)
  permitRejectionReason  String?

  managementNotes     String?
  caravanManagerNotes String?

  basicInfoLockedAt DateTime?

  rejectedAt       DateTime?
  rejectedById     String?
  rejectedBy       User?              @relation("ReservationRejecter", fields: [rejectedById], references: [id], onDelete: Restrict)
  rejectionReason  String?
  cancelledAt      DateTime?
  cancelledById    String?
  cancelledBy      User?              @relation("ReservationCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)
  returnedToStatus ReservationStatus?

  basicInfoCompletedAt   DateTime?
  basicInfoCompletedById String?
  basicInfoCompletedBy   User? @relation("ReservationBasicInfoCompleter", fields: [basicInfoCompletedById], references: [id], onDelete: Restrict)

  managementReviewedAt   DateTime?
  managementReviewedById String?
  managementReviewedBy   User? @relation("ReservationManagementReviewer", fields: [managementReviewedById], references: [id], onDelete: Restrict)

  companionsCompletedAt   DateTime?
  companionsCompletedById String?
  companionsCompletedBy   User? @relation("ReservationCompanionsCompleter", fields: [companionsCompletedById], references: [id], onDelete: Restrict)

  caravanContactsCompletedAt   DateTime?
  caravanContactsCompletedById String?
  caravanContactsCompletedBy   User? @relation("ReservationCaravanContactsCompleter", fields: [caravanContactsCompletedById], references: [id], onDelete: Restrict)

  insuranceCompletedAt   DateTime?
  insuranceCompletedById String?
  insuranceCompletedBy   User? @relation("ReservationInsuranceCompleter", fields: [insuranceCompletedById], references: [id], onDelete: Restrict)

  completedAt   DateTime?
  completedById String?
  completedBy   User? @relation("ReservationFinalCompleter", fields: [completedById], references: [id], onDelete: Restrict)

  members         ReservationMember[]
  caravanContacts ReservationCaravanContact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([year])
  @@index([type])
  @@index([status])
  @@index([year, type, status])
  @@index([caravanId])
  @@index([groupId])
  @@index([caravanManagerId])
  @@index([walkingRouteId])
  @@index([originCityId])
  @@index([hasPermit])
  @@index([permitStatus])
  @@index([issuedLicenseId])
  @@map("reservations")
}

model ReservationMember {
  id            String      @id @default(uuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  insuranceStatus          ReservationMemberInsuranceStatus @default(PENDING)
  insurancePaidAt          DateTime?
  insurancePaidAmount      Int?
  insuranceCoverageAmount  Int?
  insurancePlanId          String?
  insurancePlan            ReceptionInsurancePlan? @relation(fields: [insurancePlanId], references: [id], onDelete: SetNull)
  insurancePaymentRef      String?
  insurancePaidMethod      ReservationMemberInsurancePaidMethod?
  insurancePaidById        String?
  insurancePaidBy          User? @relation("ReservationMemberInsurancePayer", fields: [insurancePaidById], references: [id], onDelete: Restrict)
  insuranceManualNote      String?
  insuranceVerifiedAt      DateTime?
  insuranceVerifiedById    String?
  insuranceVerifiedBy      User? @relation("ReservationMemberInsuranceVerifier", fields: [insuranceVerifiedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([reservationId, userId])
  @@index([reservationId])
  @@index([userId])
  @@index([insurancePaidById])
  @@index([insurancePlanId])
  @@map("reservation_members")
}

model ReservationCaravanContact {
  id            String             @id @default(uuid())
  reservationId String
  reservation   Reservation        @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  role          CaravanContactRole
  userId        String
  user          User               @relation("ReservationCaravanContactPerson", fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([reservationId, role])
  @@index([reservationId])
  @@index([userId])
  @@map("reservation_caravan_contacts")
}

model ReceptionSettings {
  year Int @id

  individualEnabled        Boolean @default(false)
  individualMaleCapacity   Int     @default(0)
  individualFemaleCapacity Int     @default(0)
  individualAutoApprove    Boolean @default(false)
  individualIntro          String  @default("")
  individualRules          String  @default("")

  groupEnabled        Boolean @default(false)
  groupMaleCapacity   Int     @default(0)
  groupFemaleCapacity Int     @default(0)
  groupAutoApprove    Boolean @default(false)
  groupIntro          String  @default("")
  groupRules          String  @default("")

  caravanEnabled              Boolean @default(false)
  caravanMaleCapacity         Int     @default(0)
  caravanFemaleCapacity       Int     @default(0)
  caravanAutoApprove          Boolean @default(false)
  caravanAutoApproveLicenses  Boolean @default(false)
  caravanIntro                String  @default("")
  caravanRules                String  @default("")

  insuranceOrganization String @default("")
  insurancePlans        ReceptionInsurancePlan[]

  imamRezaMartyrdomDate DateTime? @db.Date
  prophetDemiseDate     DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reception_settings")
}

model ReceptionInsurancePlan {
  id             String            @id @default(uuid())
  year           Int
  settings       ReceptionSettings @relation(fields: [year], references: [year], onDelete: Cascade)
  coverageAmount Int
  premiumAmount  Int
  description    String            @default("")
  sortOrder      Int               @default(0)
  members        ReservationMember[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([year])
  @@map("reception_insurance_plans")
}

enum SmsStatus {
  SENT
  FAILED
}

model SmsSettings {
  id           String   @id @default("default")
  endpoint     String
  senderNumber String
  username     String
  password     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("sms_settings")
}

model SmsMessage {
  id               String    @id @default(uuid())
  phone            String
  body             String
  status           SmsStatus
  providerResponse String?
  sentById         String?
  sentBy           User?     @relation(fields: [sentById], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())

  @@index([createdAt])
  @@map("sms_messages")
}

model Country {
  id             String          @id @default(uuid())
  iso2           String          @unique
  iso3           String?         @unique
  phoneCode      String?
  nameFa         String
  nameEn         String
  isActive       Boolean         @default(true)
  sortOrder      Int             @default(0)
  provinces              Province[]
  accommodations         Accommodation[]
  users                  User[]
  walkingRouteOrigins    WalkingRouteOriginCountry[]
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  @@index([isActive, sortOrder])
  @@map("countries")
}

model Province {
  id             String          @id @default(uuid())
  countryId      String
  country        Country         @relation(fields: [countryId], references: [id], onDelete: Restrict)
  code           String
  nameFa         String
  nameEn         String
  neshanAddress  String?
  latitude       Decimal?        @db.Decimal(10, 7)
  longitude      Decimal?        @db.Decimal(10, 7)
  hasRailway     Boolean         @default(false)
  hasAirport     Boolean         @default(false)
  isActive       Boolean         @default(true)
  sortOrder      Int             @default(0)
  cities          City[]
  accommodations  Accommodation[]
  foodSuppliers   FoodSupplier[]
  medicalCenters  MedicalCenter[]
  redCrescents    RedCrescent[]
  benefactors      Benefactor[]
  users            User[]          @relation("UserHomeProvince")
  representativeId String?
  representative   User?           @relation("ProvinceHeadquartersRep", fields: [representativeId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([countryId, code])
  @@index([countryId, isActive, sortOrder])
  @@index([representativeId])
  @@map("provinces")
}

model City {
  id             String          @id @default(uuid())
  provinceId     String
  province       Province        @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  code           String
  nameFa         String
  nameEn         String
  neshanAddress      String?
  latitude           Decimal?        @db.Decimal(10, 7)
  longitude          Decimal?        @db.Decimal(10, 7)
  isProvinceCapital  Boolean         @default(false)
  hasRailway         Boolean         @default(false)
  hasAirport         Boolean         @default(false)
  isActive           Boolean         @default(true)
  sortOrder          Int             @default(0)
  accommodations             Accommodation[]
  foodSuppliers              FoodSupplier[]
  medicalCenters             MedicalCenter[]
  redCrescents               RedCrescent[]
  benefactors                Benefactor[]
  caravans                   Caravan[]
  groups                     Group[]
  reservationOrigins         Reservation[]             @relation("ReservationOriginCity")
  users                      User[]                    @relation("UserHomeCity")
  representativeId           String?
  representative             User?                     @relation("CityHeadquartersRep", fields: [representativeId], references: [id], onDelete: SetNull)
  walkingRouteEntryBorders   WalkingRoute[]            @relation("WalkingRouteEntryBorder")
  walkingRouteStages         WalkingRouteStage[]
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt

  @@unique([provinceId, code])
  @@index([provinceId, isActive, sortOrder])
  @@index([representativeId])
  @@map("cities")
}

enum AccommodationType {
  SCHOOL
  MOSQUE
  HUSSEINIEH
  HALL
  HOUSE
  OTHER
}

enum AccommodationStatus {
  ACTIVE
  INACTIVE
  FULL
}

enum GenderType {
  MALE
  FEMALE
  MIXED
}

enum ManagementType {
  SELF_SUFFICIENT
  SEMI_SELF_SUFFICIENT
  NON_SELF_SUFFICIENT
}

enum AccommodationContactRole {
  DEPUTY
  RECEPTION
  FACILITIES_SAFETY
  SECURITY
  HEALTH
  CULTURAL
  LOGISTICS_SUPPORT
}

model Accommodation {
  id                    String               @id @default(uuid())
  name                  String
  type                  AccommodationType

/// ارزیاب در ماتریس نظرسنجی
enum EvaluationEvaluatorType {
  UNIT_MANAGER
  CARAVAN_MANAGER
  ACCOMMODATION_MANAGER
  PILGRIM
}

/// ارزیابی‌شونده (فرد یا ستاد جمعیت)
enum EvaluationTargetType {
  CARAVAN_MANAGER
  ACCOMMODATION_MANAGER
  HEADQUARTERS
}

enum EvaluationCampaignStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum EvaluationStatus {
  IN_PROGRESS
  COMPLETED
}

/// نوع پاسخ سوال ارزیابی
enum EvaluationAnswerType {
  FIVE_SCALE
  TEXT
  YES_NO
}

/// نوبت/دوره اجرای ارزیابی
model EvaluationCampaign {
  id          String                   @id @default(uuid())
  title       String
  description String?
  startAt     DateTime                 @db.Date
  endAt       DateTime                 @db.Date
  status      EvaluationCampaignStatus @default(DRAFT)
  evaluations Evaluation[]
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([status])
  @@index([startAt])
  @@index([endAt])
  @@index([createdAt])
  @@map("evaluation_campaigns")
}

/// بانک سوالات (جفت ارزیاب × ارزیابی‌شونده)
model EvaluationQuestion {
  id            String                   @id @default(uuid())
  title         String
  description   String?
  evaluatorType EvaluationEvaluatorType
  targetType    EvaluationTargetType
  answerType    EvaluationAnswerType     @default(FIVE_SCALE)
  sortOrder     Int                      @default(0)
  isActive      Boolean                  @default(true)
  answers       EvaluationAnswer[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([evaluatorType, targetType, isActive, sortOrder])
  @@index([answerType])
  @@index([createdAt])
  @@map("evaluation_questions")
}

/// یک ارزیابی: ارزیاب × هدف × کمپین
model Evaluation {
  id            String                   @id @default(uuid())
  campaignId    String
  campaign      EvaluationCampaign       @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  evaluatorId   String
  evaluator     User                     @relation("EvaluationEvaluator", fields: [evaluatorId], references: [id], onDelete: Restrict)
  evaluatorType EvaluationEvaluatorType
  /// null وقتی targetType = HEADQUARTERS
  targetId      String?
  target        User?                    @relation("EvaluationTarget", fields: [targetId], references: [id], onDelete: Restrict)
  targetType    EvaluationTargetType
  /// برای یکتایی: targetId یا ثابت HEADQUARTERS
  targetKey     String
  status        EvaluationStatus         @default(IN_PROGRESS)
  startedAt     DateTime                 @default(now())
  completedAt   DateTime?
  submittedById String
  submittedBy   User                     @relation("EvaluationSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  submittedAt   DateTime?
  /// میانگین نمرات پنج‌گزینه‌ای (۱ خیلی خوب … ۵ خیلی ضعیف)
  performanceRank Float?
  answers       EvaluationAnswer[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@unique([campaignId, evaluatorId, evaluatorType, targetType, targetKey])
  @@index([campaignId])
  @@index([evaluatorId, evaluatorType])
  @@index([targetId, targetType])
  @@index([status])
  @@index([performanceRank])
  @@index([createdAt])
  @@map("evaluations")
}

model EvaluationAnswer {
  id           String             @id @default(uuid())
  evaluationId String
  evaluation   Evaluation         @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  questionId   String
  question     EvaluationQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  /// پنج‌گزینه‌ای: ۱ = خیلی خوب … ۵ = خیلی ضعیف
  score        Int?
  /// بله و خیر
  yesNo        Boolean?
  /// پاسخ متنی
  textValue    String?
  /// توضیح اختیاری کنار پاسخ پنج‌گزینه‌ای
  description  String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([evaluationId, questionId])
  @@index([questionId])
  @@map("evaluation_answers")
}

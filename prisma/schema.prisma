generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum UserGender {
  MALE
  FEMALE
}

enum Religion {
  ISLAM
  CHRISTIANITY
  JUDAISM
  ZOROASTRIANISM
  OTHER
}

enum SupplierType {
  GOVERNMENT_ORGANIZATION
  CHARITY
  COMPANY
  STORE
  MANUFACTURER
  WAREHOUSE
  SUPPLIER
  OTHER
}

model Role {
  id        String     @id @default(uuid())
  code      String     @unique
  nameKey   String
  userRoles UserRole[]
  menus     RoleMenu[]
  createdAt DateTime   @default(now())

  @@map("roles")
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model User {
  id                  String        @id @default(uuid())
  username            String        @unique
  passwordHash        String
  firstName           String
  lastName            String
  fullName            String
  locale              String        @default("fa")
  status              UserStatus    @default(ACTIVE)
  gender              UserGender?
  nationalId          String?       @unique
  phone               String?       @unique
  email               String?       @unique
  birthDate           DateTime?     @db.Date
  address             String?
  notes               String?
  religion            Religion?
  religionOther       String?
  telegram            String?
  bale                String?
  eitaa               String?
  whatsapp            String?
  otherSocial         String?
  vehiclePlates       String[]      @default([])
  countryId           String?
  country             Country?      @relation(fields: [countryId], references: [id], onDelete: SetNull)
  provinceId          String?
  province            Province?     @relation("UserHomeProvince", fields: [provinceId], references: [id], onDelete: SetNull)
  cityId              String?
  city                City?         @relation("UserHomeCity", fields: [cityId], references: [id], onDelete: SetNull)
  photoId             String?
  photo               StoredImage?  @relation("UserPhoto", fields: [photoId], references: [id], onDelete: SetNull)
  nationalCardPhotoId String?
  nationalCardPhoto   StoredImage?  @relation("UserNationalCard", fields: [nationalCardPhotoId], references: [id], onDelete: SetNull)
  passportPhotoId     String?
  passportPhoto       StoredImage?  @relation("UserPassport", fields: [passportPhotoId], references: [id], onDelete: SetNull)
  userRoles           UserRole[]
  smsMessages         SmsMessage[]
  managedAccommodations AccommodationManager[]
  managedCaravans       Caravan[] @relation("CaravanManager")
  caravanContacts       CaravanContact[]
  representedProvinces  Province[] @relation("ProvinceHeadquartersRep")
  representedCities     City[]     @relation("CityHeadquartersRep")
  accommodationLoans    AccommodationLoan[]
  itemQuotaVouchers     ItemQuotaVoucher[]
  iceVouchers           IceVoucher[]
  approvedIceVouchers   IceVoucher[] @relation("IceVoucherApprover")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([status])
  @@index([fullName])
  @@index([lastName])
  @@index([createdAt])
  @@index([countryId])
  @@index([provinceId])
  @@index([cityId])
  @@map("users")
}

model NavModule {
  id        String @id @default(uuid())
  code      String @unique
  nameKey   String
  icon      String
  sortOrder Int    @default(0)
  menus     Menu[]

  @@map("nav_modules")
}

model Menu {
  id        String     @id @default(uuid())
  moduleId  String
  module    NavModule  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  code      String     @unique
  nameKey   String
  path      String
  icon      String
  sortOrder Int        @default(0)
  roles     RoleMenu[]

  @@map("menus")
}

model RoleMenu {
  roleId String
  menuId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menu   Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@id([roleId, menuId])
  @@map("role_menus")
}

model StoredImage {
  id                String   @id @default(uuid())
  mimeType          String
  data              Bytes
  byteSize          Int
  width             Int?
  height            Int?
  originalName      String?
  photoUsers        User[]   @relation("UserPhoto")
  nationalCardUsers User[]   @relation("UserNationalCard")
  passportUsers     User[]   @relation("UserPassport")
  caravanLicenses   Caravan[] @relation("CaravanLicenseImage")
  createdAt         DateTime @default(now())

  @@map("stored_images")
}

enum CaravanContactRole {
  DEPUTY
  CLERIC
  CULTURAL
  SECURITY
  RECEPTION
}

model Caravan {
  id             String       @id @default(uuid())
  name           String
  description    String?
  officeAddress  String?
  officePhone    String?
  foundedYear    Int?
  licenseNumber  String?
  cityId         String
  city           City         @relation(fields: [cityId], references: [id], onDelete: Restrict)
  licenseImageId String?
  licenseImage   StoredImage? @relation("CaravanLicenseImage", fields: [licenseImageId], references: [id], onDelete: SetNull)
  managerUserId  String?
  manager        User?        @relation("CaravanManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  contacts       CaravanContact[]
  totalCount     Int          @default(0)
  maleCount      Int          @default(0)
  femaleCount    Int          @default(0)
  eitaa          String?
  bale           String?
  telegram       String?
  instagram      String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([cityId])
  @@index([managerUserId])
  @@index([isActive])
  @@map("caravans")
}

model CaravanContact {
  id        String             @id @default(uuid())
  caravanId String
  caravan   Caravan            @relation(fields: [caravanId], references: [id], onDelete: Cascade)
  role      CaravanContactRole
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([caravanId, role])
  @@index([userId])
  @@map("caravan_contacts")
}

enum SmsStatus {
  SENT
  FAILED
}

model SmsSettings {
  id           String   @id @default("default")
  endpoint     String
  senderNumber String
  username     String
  password     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("sms_settings")
}

model SmsMessage {
  id               String    @id @default(uuid())
  phone            String
  body             String
  status           SmsStatus
  providerResponse String?
  sentById         String?
  sentBy           User?     @relation(fields: [sentById], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())

  @@index([createdAt])
  @@map("sms_messages")
}

model Country {
  id             String          @id @default(uuid())
  iso2           String          @unique
  iso3           String?         @unique
  phoneCode      String?
  nameFa         String
  nameEn         String
  isActive       Boolean         @default(true)
  sortOrder      Int             @default(0)
  provinces              Province[]
  accommodations         Accommodation[]
  users                  User[]
  walkingRouteOrigins    WalkingRouteOriginCountry[]
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  @@index([isActive, sortOrder])
  @@map("countries")
}

model Province {
  id             String          @id @default(uuid())
  countryId      String
  country        Country         @relation(fields: [countryId], references: [id], onDelete: Restrict)
  code           String
  nameFa         String
  nameEn         String
  neshanAddress  String?
  latitude       Decimal?        @db.Decimal(10, 7)
  longitude      Decimal?        @db.Decimal(10, 7)
  hasRailway     Boolean         @default(false)
  hasAirport     Boolean         @default(false)
  isActive       Boolean         @default(true)
  sortOrder      Int             @default(0)
  cities          City[]
  accommodations  Accommodation[]
  foodSuppliers   FoodSupplier[]
  medicalCenters  MedicalCenter[]
  redCrescents    RedCrescent[]
  benefactors      Benefactor[]
  users            User[]          @relation("UserHomeProvince")
  representativeId String?
  representative   User?           @relation("ProvinceHeadquartersRep", fields: [representativeId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([countryId, code])
  @@index([countryId, isActive, sortOrder])
  @@index([representativeId])
  @@map("provinces")
}

model City {
  id             String          @id @default(uuid())
  provinceId     String
  province       Province        @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  code           String
  nameFa         String
  nameEn         String
  neshanAddress      String?
  latitude           Decimal?        @db.Decimal(10, 7)
  longitude          Decimal?        @db.Decimal(10, 7)
  isProvinceCapital  Boolean         @default(false)
  hasRailway         Boolean         @default(false)
  hasAirport         Boolean         @default(false)
  isActive           Boolean         @default(true)
  sortOrder          Int             @default(0)
  accommodations             Accommodation[]
  foodSuppliers              FoodSupplier[]
  medicalCenters             MedicalCenter[]
  redCrescents               RedCrescent[]
  benefactors                Benefactor[]
  caravans                   Caravan[]
  users                      User[]                    @relation("UserHomeCity")
  representativeId           String?
  representative             User?                     @relation("CityHeadquartersRep", fields: [representativeId], references: [id], onDelete: SetNull)
  walkingRouteEntryBorders   WalkingRoute[]            @relation("WalkingRouteEntryBorder")
  walkingRouteStages         WalkingRouteStage[]
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt

  @@unique([provinceId, code])
  @@index([provinceId, isActive, sortOrder])
  @@index([representativeId])
  @@map("cities")
}

enum AccommodationType {
  SCHOOL
  MOSQUE
  HUSSEINIEH
  HALL
  HOUSE
  OTHER
}

enum AccommodationStatus {
  ACTIVE
  INACTIVE
  FULL
}

enum GenderType {
  MALE
  FEMALE
  MIXED
}

enum ManagementType {
  SELF_SUFFICIENT
  SEMI_SELF_SUFFICIENT
  NON_SELF_SUFFICIENT
}

model Accommodation {
  id                    String               @id @default(uuid())
  name                  String
  type                  AccommodationType
  status                AccommodationStatus  @default(ACTIVE)
  genderType            GenderType
  managementType        ManagementType       @default(SELF_SUFFICIENT)
  maleCapacity          Int                  @default(0)
  femaleCapacity        Int                  @default(0)
  assignedMaleCapacity  Int                  @default(0)
  assignedFemaleCapacity Int                 @default(0)
  phone                 String?
  address               String?
  neshanAddress         String?
  latitude              Decimal?             @db.Decimal(10, 7)
  longitude             Decimal?             @db.Decimal(10, 7)
  eitaa                 String?
  bale                  String?
  otherSocial           String?
  description           String?
  countryId             String?
  country               Country?             @relation(fields: [countryId], references: [id], onDelete: SetNull)
  provinceId            String?
  province              Province?            @relation(fields: [provinceId], references: [id], onDelete: SetNull)
  cityId                String?
  city                  City?                @relation(fields: [cityId], references: [id], onDelete: SetNull)
  distanceToShrineKm    Decimal?             @db.Decimal(8, 2)
  distanceToMashhadKm   Decimal?             @db.Decimal(8, 2)
  hasLaundry            Boolean              @default(false)
  hasInternet           Boolean              @default(false)
  hasPrayerRoom         Boolean              @default(false)
  hasElevator           Boolean              @default(false)
  heatingSystem         String?
  coolingSystem         String?
  parkingCapacity       Int?
  bathroomCount         Int?
  toiletCount           Int?
  managers              AccommodationManager[]
  iceVouchers           IceVoucher[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([name])
  @@index([status, type])
  @@index([managementType, genderType])
  @@index([cityId])
  @@map("accommodations")
}

model AccommodationManager {
  id               String        @id @default(uuid())
  accommodationId  String
  accommodation    Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  year             Int
  isPrimary        Boolean       @default(false)
  createdAt        DateTime      @default(now())

  @@unique([userId, accommodationId, year])
  @@index([userId])
  @@index([year])
  @@index([accommodationId, year])
  @@map("accommodation_managers")
}

model FoodSupplier {
  id          String   @id @default(uuid())
  name        String
  phone       String?
  address     String?
  description String?
  provinceId  String
  province    Province @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  cityId      String
  city        City     @relation(fields: [cityId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([provinceId])
  @@index([cityId])
  @@map("food_suppliers")
}

model MedicalCenter {
  id            String   @id @default(uuid())
  name          String
  phone         String?
  address       String?
  neshanAddress String?
  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)
  description   String?
  provinceId    String
  province      Province @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  cityId        String
  city          City     @relation(fields: [cityId], references: [id], onDelete: Restrict)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([name])
  @@index([provinceId])
  @@index([cityId])
  @@map("medical_centers")
}

model RedCrescent {
  id            String   @id @default(uuid())
  name          String
  phone         String?
  address       String?
  neshanAddress String?
  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)
  description   String?
  provinceId    String
  province      Province @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  cityId        String
  city          City     @relation(fields: [cityId], references: [id], onDelete: Restrict)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([name])
  @@index([provinceId])
  @@index([cityId])
  @@map("red_crescents")
}

model Benefactor {
  id            String   @id @default(uuid())
  name          String
  phone         String?
  address       String?
  neshanAddress String?
  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)
  description   String?
  provinceId    String
  province      Province @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  cityId        String
  city          City     @relation(fields: [cityId], references: [id], onDelete: Restrict)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([name])
  @@index([provinceId])
  @@index([cityId])
  @@map("benefactors")
}

model WalkingRoute {
  id                  String                      @id @default(uuid())
  name                String
  distanceToMashhadKm Decimal                     @db.Decimal(8, 2)
  entryBorderCityId   String
  entryBorderCity     City                        @relation("WalkingRouteEntryBorder", fields: [entryBorderCityId], references: [id], onDelete: Restrict)
  originCountries     WalkingRouteOriginCountry[]
  stages              WalkingRouteStage[]
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  @@index([name])
  @@index([entryBorderCityId])
  @@map("walking_routes")
}

model WalkingRouteOriginCountry {
  walkingRouteId String
  countryId      String
  walkingRoute   WalkingRoute @relation(fields: [walkingRouteId], references: [id], onDelete: Cascade)
  country        Country      @relation(fields: [countryId], references: [id], onDelete: Restrict)

  @@id([walkingRouteId, countryId])
  @@index([countryId])
  @@map("walking_route_origin_countries")
}

model WalkingRouteStage {
  id                   String       @id @default(uuid())
  walkingRouteId       String
  walkingRoute         WalkingRoute @relation(fields: [walkingRouteId], references: [id], onDelete: Cascade)
  cityId               String
  city                 City         @relation(fields: [cityId], references: [id], onDelete: Restrict)
  stageNumber          Int
  distanceToNextKm     Decimal?     @db.Decimal(8, 2)
  distanceToPreviousKm Decimal?     @db.Decimal(8, 2)
  distanceToMashhadKm  Decimal?     @db.Decimal(8, 2)
  description          String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([walkingRouteId, stageNumber])
  @@index([cityId])
  @@map("walking_route_stages")
}

model Supplier {
  id            String             @id @default(uuid())
  name          String
  type          SupplierType
  address       String?
  phone         String?
  contactPerson String?
  description   String?
  items         SupplierItem[]
  itemQuotas    ItemQuota[]
  vouchers      ItemQuotaVoucher[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([name])
  @@index([type])
  @@map("suppliers")
}

model SupplierItem {
  id           String               @id @default(uuid())
  supplierId   String
  supplier     Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  year         Int
  name         String
  unit         String
  quantity     Int
  deliveryDate DateTime             @db.Date
  returnDate   DateTime?            @db.Date
  description  String?
  loans        AccommodationLoan[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([supplierId, year])
  @@index([year])
  @@index([name])
  @@map("supplier_items")
}

model AccommodationLoan {
  id                     String       @id @default(uuid())
  supplierItemId         String
  supplierItem           SupplierItem @relation(fields: [supplierItemId], references: [id], onDelete: Restrict)
  accommodationManagerId String
  accommodationManager   User         @relation(fields: [accommodationManagerId], references: [id], onDelete: Restrict)
  quantity               Int
  deliveryDate           DateTime     @db.Date
  plannedReturnDate      DateTime?    @db.Date
  actualReturnDate       DateTime?    @db.Date
  returnedQuantity       Int?
  description            String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@index([supplierItemId])
  @@index([accommodationManagerId])
  @@index([deliveryDate])
  @@map("accommodation_loans")
}

model ItemQuota {
  id          String             @id @default(uuid())
  year        Int
  name        String
  unit        String
  quantity    Int
  supplierId  String?
  supplier    Supplier?          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  description String?
  vouchers    ItemQuotaVoucher[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([year])
  @@index([name])
  @@index([supplierId])
  @@map("item_quotas")
}

model ItemQuotaVoucher {
  id                     String    @id @default(uuid())
  code                   String    @unique
  quotaId                String
  quota                  ItemQuota @relation(fields: [quotaId], references: [id], onDelete: Restrict)
  accommodationManagerId String
  accommodationManager   User      @relation(fields: [accommodationManagerId], references: [id], onDelete: Restrict)
  quantity               Int
  supplierId             String?
  supplier               Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierName           String
  pickupLocation         String?
  description            String?
  issuedAt               DateTime  @default(now())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([quotaId])
  @@index([accommodationManagerId])
  @@index([issuedAt])
  @@map("item_quota_vouchers")
}

enum IceVoucherStatus {
  PENDING
  APPROVED
  REJECTED
}

enum IceVoucherPaymentStatus {
  UNPAID
  PAID
}

model IceVoucherSettings {
  id                 String    @id @default("default")
  moldsPer50Pilgrims Int       @default(1)
  costPerMold        Int       @default(0)
  activityStartDate  DateTime? @db.Date
  activityEndDate    DateTime? @db.Date
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("ice_voucher_settings")
}

model IceVoucher {
  id                     String           @id @default(uuid())
  code                   String           @unique
  year                   Int
  accommodationId        String
  accommodation          Accommodation    @relation(fields: [accommodationId], references: [id], onDelete: Restrict)
  accommodationManagerId String
  accommodationManager   User             @relation(fields: [accommodationManagerId], references: [id], onDelete: Restrict)
  requestedAt            DateTime         @db.Date
  moldCount              Int
  costPerMold            Int
  totalCost              Int
  description            String?
  status                 IceVoucherStatus @default(PENDING)
  paymentStatus          IceVoucherPaymentStatus @default(UNPAID)
  paidAt                 DateTime?
  approvedAt             DateTime?
  approvedById           String?
  approvedBy             User?            @relation("IceVoucherApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@index([year])
  @@index([accommodationId])
  @@index([accommodationManagerId])
  @@index([status, requestedAt])
  @@index([paymentStatus])
  @@map("ice_vouchers")
}
